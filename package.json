{
  "name": "data-contract-validator",
  "version": "2.0.0",
  "description": "Check data contracts and reconcile migrations: load readiness, record-by-record reconciliation, evidence packs. Runs locally; data never leaves the machine.",
  "keywords": [
    "data-contract",
    "data-quality",
    "data-migration",
    "reconciliation",
    "etl",
    "sap",
    "odcs",
    "open-data-contract-standard",
    "csv",
    "evidence",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/AbhikM-Create/data-contract-validator#readme",
  "bugs": {
    "url": "https://github.com/AbhikM-Create/data-contract-validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhikM-Create/data-contract-validator.git"
  },
  "type": "module",
  "bin": {
    "dcv": "bin/dcv.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "bin/",
    "cli/",
    "scripts/lib/*.mjs",
    "src/lib/*.js",
    "!src/lib/*.test.js",
    "!src/lib/supabase.js",
    "!src/lib/useAuth.js",
    "!src/lib/contractStore.js",
    "!src/lib/runStore.js",
    "!src/lib/engineClient.js",
    "!src/lib/engineWorker.js",
    "schemas/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:rls": "sh scripts/verify-rls.sh",
    "sbom": "node scripts/sbom.mjs > sbom.cdx.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.20.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
