# Copy to .env.local and fill in from Supabase → Settings → API.
#
# The publishable (anon) key is PUBLIC by design: it ships inside the browser
# bundle and anyone can read it. Row Level Security is what protects the data,
# not the secrecy of this key.
#
# Never put the secret / service_role key here — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
